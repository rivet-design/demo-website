# Existing browser configuration (public Supabase anon key, never the service key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_CLAY_PROXY_URL=https://rivet-clay-proxy.your-account.workers.dev

# Install-link Worker bindings. These are server-only; do not add VITE_ prefixes.
# Set secrets with wrangler secret put; .env.local is NOT deployed to the Worker.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INSTALL_LINK_FROM=Rivet <hello@rivet.design>
PUBLIC_SITE_URL=https://rivet.design
